<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder><pattern>%d{HH:mm:ss} %-5level %msg%n</pattern></encoder>
    </appender>
    <!-- SDK diagnostics may contain request bodies or credential-bearing URLs. -->
    <root level="OFF"><appender-ref ref="CONSOLE"/></root>
    <logger name="bridge.echo" level="INFO"/>
</configuration>
